{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CakeVPN",
  "version": "1.4.3",
  "identifier": "com.cakevpn.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CakeVPN",
        "width": 380,
        "height": 660,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sing-box",
      "binaries/cakevpn-helper"
    ],
    "copyright": "CakeVPN",
    "category": "Utility",
    "shortDescription": "CakeVPN",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDMjA1ODdFMDU3QUQwNkEKUldScTBIb0ZmbGdnek0zZkJwUWpDSVlvNU8wOVBVcFZxUnZCMjZyZXdqd0g1THNSYktnNUltdDMK",
      "endpoints": [
        "https://github.com/badcakee/cakevpn-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
